classDiagram
    direction TB

    %% Relacionamentos principais da Obra
    Obra "1" *-- "0..*" ItemEap : contém (eap)
    Obra "1" *-- "0..*" EtapaObra : possui (etapas)
    Obra "*" --> "0..1" Empresa : contratada (empresa)
    Obra "*" --> "1" StatusObra : status
    Obra "*" --> "1" UnidadeFederativa : uf

    %% Relacionamentos da EAP e Etapas
    ItemEap "*" --> "1" Obra : pertence a
    ItemEap "0..1" *-- "0..*" ItemEap : hierarquia (pai/filhos)
    ItemEap "0..1" o-- "0..1" EtapaObra : associa-se (etapa)

    %% Relacionamentos da Etapa de Obra
    EtapaObra "1" *-- "1" CpmInfo : cpm (embedded)
    EtapaObra "1" *-- "0..*" ItemOrcamento : orçamentos
    EtapaObra "1" *-- "0..*" MedicaoEtapa : medições
    EtapaObra "*" <--> "*" EtapaObra : dependência CPM (predecessores/sucessores)

    %% Relacionamento de Medição
    MedicaoEtapa "*" --> "1" EtapaObra : etapa

    %% Herança e associações de Itens de Orçamento
    ItemOrcamentoInsumo --|> ItemOrcamento : é um
    ItemOrcamentoComposicao --|> ItemOrcamento : é um
    ItemOrcamentoInsumo "*" --> "1" Insumo : referencia
    ItemOrcamentoComposicao "*" --> "1" Composicao : referencia

    %% Composite Pattern de Composição e Insumos
    Insumo --|> ItemComposicao : é um
    Composicao --|> ItemComposicao : é um
    Composicao "1" *-- "0..*" ItemComposicao : itens (composicaoPai)
    ItemComposicao "*" --> "1" UnidadeMedida : unidade

    %% Definições de Classes
    class Obra {
        -UUID id
        -String descricao
        -StatusObra status
        -Empresa empresa
        -UnidadeFederativa uf
        -ZoneId fusoHorario
        -List~EtapaObra~ etapas
        -List~ItemEap~ eap
        +atualizar(String, UnidadeFederativa, ZoneId, Empresa)
        +atualizarParcial(String, UnidadeFederativa, ZoneId, Empresa)
        +adicionarEtapa(EtapaObra)
        +adicionarItemEap(ItemEap)
    }

    class Empresa {
        -UUID id
        -String nome
        -String cnpj
        -String razaoSocial
        +atualizar(String, String, String)
        +atualizarParcial(String, String, String)
    }

    class ItemEap {
        -UUID id
        -String nome
        -String codigoEap
        -String bancoOrcamento
        -String codigoComposicao
        -String tipoComposicao
        -String macroetapa
        -String unidadeOrcamento
        -BigDecimal quantidadeOrcada
        -BigDecimal valorUnitarioOrcado
        -BigDecimal valorUnitarioBase
        -BigDecimal percentualBdi
        -BigDecimal valorTotalOrcado
        -Obra obra
        -Double posicao
        -ItemEap pai
        -List~ItemEap~ filhos
        -EtapaObra etapa
        +atualizarDadosOrcamento(...)
    }

    class EtapaObra {
        -UUID id
        -String descricao
        -OffsetDateTime inicio
        -OffsetDateTime fim
        -Integer prazoEsperadoDias
        -CpmInfo cpm
        -List~EtapaObra~ predecessores
        -List~EtapaObra~ sucessores
        -List~ItemOrcamento~ orcamentos
        -List~MedicaoEtapa~ medicoes
        +registrarMedicao(BigDecimal, BigDecimal, String, String, Integer) MedicaoEtapa
    }

    class CpmInfo {
        <<embeddable>>
        -OffsetDateTime earlyStart
        -OffsetDateTime earlyFinish
        -OffsetDateTime lateStart
        -OffsetDateTime lateFinish
        -Integer folgaDias
        -Boolean caminhoCritico
    }

    class MedicaoEtapa {
        -UUID id
        -EtapaObra etapa
        -BigDecimal percentualExecutado
        -BigDecimal quantidadeExecutada
        -String observacao
        -String motivoAtraso
        -Integer diasAtraso
        -OffsetDateTime registradaEm
    }

    class ItemOrcamento {
        <<abstract>>
        -UUID id
        -BigDecimal quantidade
    }

    class ItemOrcamentoInsumo {
        -Insumo insumo
    }

    class ItemOrcamentoComposicao {
        -Composicao composicao
    }

    class ItemComposicao {
        <<abstract>>
        -UUID id
        -String codigo
        -String descricao
        -UnidadeMedida unidade
        -BigDecimal preco
        -Composicao composicaoPai
        +atualizar(String, String, UnidadeMedida, BigDecimal)
        +atualizarParcial(String, String, UnidadeMedida, BigDecimal)
    }

    class Insumo {
    }

    class Composicao {
        -List~ItemComposicao~ itens
        +getItens() List~UUID~
        +adicionarItem(ItemComposicao) Composicao
        +removerItem(ItemComposicao)
    }

    class StatusObra {
        <<enumeration>>
        EM_PLANEJAMENTO
        EM_ANDAMENTO
        PAUSADA
        CONCLUIDA
        CANCELADA
    }

